# Public API base URL used by Real API doc examples (no secrets here).
NEXT_PUBLIC_API_BASE_URL=https://jsonplaceholder.typicode.com

# Server proxy allowlist: comma-separated hostnames the /api/proxy route may
# forward to. Private tokens stay server-side — the browser never sees them.
API_PROXY_ALLOWLIST=jsonplaceholder.typicode.com,dummyjson.com
# Optional server-side token injected by the proxy (never NEXT_PUBLIC_*).
API_PROXY_TOKEN=
